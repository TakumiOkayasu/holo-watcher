# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# /api/notify Bearer Token
NOTIFY_API_TOKEN=your_notify_api_token_here

# GitHub Token (optional: for fetching failed job/step details + webhook sync)
# Fine-grained PAT: actions:read, administration:write
GITHUB_TOKEN=github_pat_xxxxx

# Webhook sync target URL (optional: for /api/sync-webhooks)
WEBHOOK_URL=https://workers.example.com/webhook

# Allowed GitHub Owner/Org (optional, comma-separated)
ALLOWED_OWNER=your_github_owner_here

# Discord Interactions `/alive` (Worker secrets; IDs must not be committed)
DISCORD_PUBLIC_KEY=your_discord_application_public_key
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_ALLOWED_GUILD_IDS=your_allowed_guild_id
DISCORD_ALLOWED_USER_IDS=your_allowed_user_id
VAULTWARDEN_HEALTH_URL=https://vault.example.com/alive

# Local/CI only: used to register the guild command, never upload to Worker secrets
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_COMMAND_GUILD_ID=your_discord_guild_id
